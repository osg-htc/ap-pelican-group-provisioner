# Copy to .env for local runs. Never commit .env.
#
# Structure lives in config.yaml (see config.example.yaml). This file holds the secrets and
# any per-environment overrides; every variable here beats the same setting in the file.

# --- secrets ---
LDAP_BIND_PASSWORD=
# A JWT minted by the Origin (see design/user-collections.md, Authentication) ...
PELICAN_API_TOKEN=

# --- optional overrides ---
# CONFIG_FILE=/etc/provisioner/config.yaml
# PELICAN_VERIFY_TLS=false       # local self-signed Origin only
# DRY_RUN=true
# ALLOW_MASS_DELETE=true        # one run only: bypass the deletion ceiling (e.g. base_path change)
# LOG_LEVEL=DEBUG

# --- file-less deployment ---
# Without a config file, all ldap.* and pelican.* settings come from LDAP_* / PELICAN_*
# variables and a single job from these two:
# LDAP_GROUP=ap40-login
# PELICAN_BASE_PATH=/test/data
